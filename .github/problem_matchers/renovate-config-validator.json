{
  "problemMatcher": [
    {
      "owner": "renovate-config-validator",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^\\s*\"file\":\\s*\"(.+)\",?\\s*$",
          "file": 1
        },
        {
          "regexp": "^\\s*\"message\":\\s+\"(.+)\",?\\s*$",
          "message": 1,
          "loop": true
        }
      ]
    }
  ]
}
